{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["automerge"],
  "ignorePaths": ["**/autogenerated-**"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/postgres/"],
      "matchUpdateTypes": ["major"],
      "labels": []
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "terraform -chdir=infrastructure init -backend=false -upgrade",
      "terraform -chdir=service init -backend=false -upgrade"
    ],
    "executionMode": "branch",
    "fileFilters": ["**/.terraform.lock.hcl"],
    "excludeCommitPaths": []
  }
}
