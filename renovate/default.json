{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["automerge"],
  "dependencyDashboard": true,
  "gitIgnoredAuthors": ["renovate@whitesourcesoftware.com"],
  "ignorePaths": ["**/autogenerated-**"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "dependencyDashboardApproval": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/postgres/",
        "/(^|\/)(mariadb|mysql|mongo|mongodb|redis|valkey)$/"
      ],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": []
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "terraform -chdir=infrastructure init -backend=false -upgrade",
      "terraform -chdir=service init -backend=false -upgrade"
    ],
    "executionMode": "branch",
    "fileFilters": ["**/.terraform.lock.hcl"],
    "excludeCommitPaths": []
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["automerge", "security"]
  }
}
